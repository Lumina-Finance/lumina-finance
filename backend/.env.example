# Backend production environment example
# Copy to backend/.env and fill in real values for the deployment

RUNTIME=server

# Public origin of the frontend, used as the CORS origin
APP_URL=http://localhost:5173

# Database connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=change-me

# JWT signing
JWT_ACCESS_KID=access-v1-00000000
JWT_REFRESH_KID=refresh-v1-00000000
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=86400
JWT_ISSUER=lumina-finance

# Key paths must be absolute, point them at the deployed key files
JWT_ACCESS_PRIVATE_KEY_PATH=/absolute/path/to/backend/keys/access_private.pem
JWT_REFRESH_PRIVATE_KEY_PATH=/absolute/path/to/backend/keys/refresh_private.pem

# Update checks
APP_VERSION=0.0.0
UPDATE_CHECKS_ENABLED=true

# Foreign exchange rate source
FRANKFURTER_URL=https://api.frankfurter.dev/v2

# Email delivery, smtp delivers through the server below, logging prints mail to the log
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# From address for outgoing mail, defaults to SMTP_USERNAME when left blank
MAIL_FROM=

# Cap on reset emails per account per rolling day
PASSWORD_RESET_DAILY_EMAIL_LIMIT=3

# OIDC single sign-on. Providers are google (issuer and name preset, only credentials
# needed) and generic (any standards-compliant provider such as Authentik or Authelia)
#OIDC_PROVIDERS=google,generic
#OIDC_GOOGLE_CLIENT_ID=
#OIDC_GOOGLE_CLIENT_SECRET=
#OIDC_GENERIC_ISSUER=https://auth.example.com
#OIDC_GENERIC_DISPLAY_NAME=Example SSO
#OIDC_GENERIC_CLIENT_ID=
#OIDC_GENERIC_CLIENT_SECRET=
