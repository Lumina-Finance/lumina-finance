# Docker deployment environment example
# Copy to docker/.env and fill in real values

# Database connection, the host is the compose service name
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=change-me

# Public origin of the app, used as the CORS origin
APP_URL=

# Update checks reach the network, keep on for server deployments
UPDATE_CHECKS_ENABLED=true

# Foreign exchange rate source
FRANKFURTER_URL=https://api.frankfurter.dev/v2

# Email delivery, smtp delivers through the server below, logging prints mail to the log
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# From address for outgoing mail, defaults to SMTP_USERNAME when left blank
MAIL_FROM=

# Cap on reset emails per account per rolling day
PASSWORD_RESET_DAILY_EMAIL_LIMIT=3

# OIDC single sign-on. List provider slugs, then configure each through its own
# OIDC_<SLUG>_* block. The google slug fills in its issuer and display name automatically
#OIDC_PROVIDERS=google,sso
#OIDC_GOOGLE_CLIENT_ID=
#OIDC_GOOGLE_CLIENT_SECRET=
#OIDC_SSO_ISSUER=https://auth.example.com
#OIDC_SSO_DISPLAY_NAME=Example SSO
#OIDC_SSO_CLIENT_ID=
#OIDC_SSO_CLIENT_SECRET=
