# Backend production environment example
# Copy to backend/.env and fill in real values for the deployment

RUNTIME=server

# Public origin of the frontend
APP_URL=http://localhost:5173

# Database connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=change-me

# JWT signing
JWT_ACCESS_KID=access-v1-00000000
JWT_REFRESH_KID=refresh-v1-00000000
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=86400
JWT_ISSUER=lumina-finance

# Absolute paths to the deployed key files
JWT_ACCESS_PRIVATE_KEY_PATH=/absolute/path/to/backend/keys/access_private.pem
JWT_REFRESH_PRIVATE_KEY_PATH=/absolute/path/to/backend/keys/refresh_private.pem

# Key for OFX import duplicate detection, 64 lower-case hex characters from: openssl rand -hex 32. Back it up with the database
BANK_TRANSACTION_HASH_KEY=

# Whether new accounts can be created
REGISTRATION_ENABLED=true

# Update checks
APP_VERSION=0.0.0
UPDATE_CHECKS_ENABLED=true

# Foreign exchange rate source
FRANKFURTER_URL=https://api.frankfurter.dev/v2

# Cache for foreign exchange rates
#VALKEY_URL=valkey://127.0.0.1:6379

# Email delivery, smtp sends mail and logging prints it to the log
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# From address for outgoing mail
MAIL_FROM=

# Cap on reset emails per account per rolling day
PASSWORD_RESET_DAILY_EMAIL_LIMIT=3

# OIDC single sign-on, the issuer and client secret are required once the client id is set
#OIDC_GENERIC_ISSUER=https://auth.example.com
#OIDC_GENERIC_CLIENT_ID=
#OIDC_GENERIC_CLIENT_SECRET=
# Sign-in button label
#OIDC_GENERIC_DISPLAY_NAME=Example SSO
# Set to false if new sign-ups fail with "Identity provider did not verify the email address"
#OIDC_REQUIRE_VERIFIED_EMAIL=true
