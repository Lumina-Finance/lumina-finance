# Docker deployment environment example
# Copy to docker/.env and fill in real values

# Database connection, the host is the compose service name
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=change-me

# Public origin of the app, used as the CORS origin
APP_URL=

# Update checks reach the network, keep on for server deployments
UPDATE_CHECKS_ENABLED=true

# Foreign exchange rate source
FRANKFURTER_URL=https://api.frankfurter.dev/v2

# Email delivery. The default logging backend prints mail such as password reset links to the
# container log instead of delivering it. To deliver real mail, set EMAIL_BACKEND=smtp and
# fill in the server settings below
EMAIL_BACKEND=logging
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_USE_TLS=true

# From address for outgoing mail, defaults to SMTP_USERNAME when left blank
#MAIL_FROM=

# Cap on reset emails per account per rolling day
PASSWORD_RESET_DAILY_EMAIL_LIMIT=3

# OIDC single sign-on with any standards-compliant provider such as Authentik or Authelia.
# Setting the client id turns it on, and the issuer and client secret are then required
#OIDC_GENERIC_ISSUER=https://auth.example.com
#OIDC_GENERIC_CLIENT_ID=
#OIDC_GENERIC_CLIENT_SECRET=
# The display name is the sign-in button label. Naming it after the app such as
# Authentik also shows that app's logo on the button, matched from the self-hosted icon set
#OIDC_GENERIC_DISPLAY_NAME=Example SSO
# Require the provider to assert email_verified as true before a first sign-in can create an account.
# Strict by default. Authentik and Authelia hardcode this claim without real verification, so set it
# false when using them
#OIDC_REQUIRE_VERIFIED_EMAIL=true
