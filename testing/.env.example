# Application vars
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=change-me
APP_URL=http://localhost:8080
FRANKFURTER_URL=https://api.frankfurter.dev/v2

# Vars used by local development and pytest database resets
DEV_PG_CONTAINER=lumina-finance-dev-db

# Vars used by backend pytest
TESTING=1
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=lumina_test
TEST_DB_USER=lumina_test
TEST_DB_PASSWORD=lumina_test

# Vars used for testing docker stack deployment locally
TEST_INSTANCE_BIND_HOST=127.0.0.1
TEST_INSTANCE_PORT=8080
TEST_INSTANCE_IMAGE=lumina-finance:testing
TEST_INSTANCE_PROJECT=lumina-testing

# Vars used for getting live staging data from remote server
REMOTE_SSH_HOST=
REMOTE_DB_CONTAINER=
