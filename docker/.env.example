# Docker deployment environment example
# Copy to docker/.env and fill in real values

# Database connection, the host is the Compose service name
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=change-me

# Public origin of the app
APP_URL=

# How much the app logs: DEBUG, INFO, WARNING or ERROR. fail2ban needs INFO or DEBUG
#LOG_LEVEL=INFO

# Trusted reverse proxies, separated by spaces, as addresses or ranges such as 203.0.113.7/32. Private addresses are trusted by default, so name a proxy on a public address
#TRUSTED_PROXIES=private_ranges

# Key for OFX import duplicate detection, 64 lower-case hex characters from: openssl rand -hex 32. Generated into /data/secrets on first start when unset. Back it up with the database, and if it is lost run: docker compose run --rm app reset-bank-transaction-hash-key
#BANK_TRANSACTION_HASH_KEY=

# Whether new accounts can be created, false also closes single sign-on sign-up
REGISTRATION_ENABLED=true

# Update checks
UPDATE_CHECKS_ENABLED=true

# Foreign exchange rate source
FRANKFURTER_URL=https://api.frankfurter.dev/v2

# Cache for foreign exchange rates, blank runs without it
VALKEY_URL=valkey://valkey:6379

# Email delivery, logging prints mail to the container log and smtp sends it with the settings below
EMAIL_BACKEND=logging
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_USE_TLS=true

# From address for outgoing mail, SMTP_USERNAME when blank
#MAIL_FROM=

# Cap on reset emails per account per rolling day
PASSWORD_RESET_DAILY_EMAIL_LIMIT=3

# OIDC single sign-on, the issuer and client secret are required once the client id is set
#OIDC_GENERIC_ISSUER=https://auth.example.com
#OIDC_GENERIC_CLIENT_ID=
#OIDC_GENERIC_CLIENT_SECRET=
# Sign-in button label
#OIDC_GENERIC_DISPLAY_NAME=Example SSO
# Set to false if new sign-ups fail with "Identity provider did not verify the email address"
#OIDC_REQUIRE_VERIFIED_EMAIL=true
