Table users [headercolor: #3B82F6] {
  id uuid pk
  email varchar(254) [not null, unique, note: "RFC 3696: 254 character practical limit for email addresses"]
  first_name varchar(256) [not null]
  last_name varchar(256)
  profile_pic text [note: "the location of the profile picture"]
  tz varchar(40) [not null, note: "IANA timezone identifier (e.g., America/Toronto), auto-derived from device"]
  base_currency char(3) [not null, ref: > currencies.id, note: "mandatory base currency for aggregate views and FX conversion"]
  created_at timestamptz [not null]
}

Table households [headercolor: #8B5CF6] {
  id uuid pk
  owner_id uuid [not null, ref: > users.id]
  name text
  profile_pic text [note: "the location of the profile picture"]
  created_at timestamptz [not null]
}

enum household_role {
  admin [note: "full control: manage members, edit all shared objects"]
  editor [note: "can create and edit shared objects but cannot manage members"]
  viewer [note: "read-only access to shared household data"]
}

Table household_members [headercolor: #8B5CF6] {
  household_id uuid pk [ref: > households.id]
  user_id uuid pk [ref: > users.id]
  role household_role [not null, default: "viewer"]
}

// Only supporting passwords for now
enum auth_provider {
  password
  // google
  // github
  // generic_oidc [note: "to accomodate self hosted solutions like Authentik, Gitea, etc."]
}

Table auth_identities [headercolor: #3B82F6] {
  id uuid pk
  user_id uuid [ref: > users.id]
  auth_provider auth_provider [not null]
  email_verified boolean [not null, default: false]
  email_verified_at timestamptz
  // unique constraint: (user_id, auth_provider)
}

Table password_credentials [headercolor: #3B82F6] {
  user_id uuid pk [ref: - users.id]
  password_hash text [not null]
  password_algo text [not null]
  updated_at timestamptz [not null]
  failed_attempt_count int [not null, default: 0, note: "should be zeroed out once user successfully authenticate"]
  locked_until timestamptz [default: null, note: "used to lock the user's account after too many failed attempts"]
}

enum institution_status {
  canonical
  pending
}

Table institutions [headercolor: #64748B, note: "globally available table"] {
  id uuid pk
  status institution_status [not null, default: "pending"]
  name varchar(256) [not null]
  country_code char(2) [not null]
  website text [not null]

  indexes {
    (name, country_code) [unique, name: "uq_institution_name_country"]
  }
}

Table currencies [headercolor: #64748B] {
  id char(3) pk
  name varchar(64) [not null, note: "spelled out full term in singular (e.g., Canadian Dollar)"]
  symbol varchar(8) [not null]
  minor_unit_exponent smallint [not null, note: "e.g., CAD=2, JPY=0, BHD=3"]
}

enum tax_treatment {
  taxable [note: "e.g., checking, savings, investment"]
  tax_free [note: "e.g., TFSA, Roth IRA, FHSA"]
  tax_deferred [note: "e.g., RRSP, 401k, traditional IRA"]
  tax_assisted [note: "e.g., RESP — grants/matching, taxed on withdrawal in beneficiary's hands"]
}

enum account_type {
  checking
  savings
  credit_card
  cash
  investment
}

Table accounts [headercolor: #10B981, note: "check constraint: exactly one of owner_id or household_id must be non-null"] {
  id uuid pk
  owner_id uuid [ref: > users.id]
  household_id uuid [ref: > households.id]
  account_type account_type [not null]
  tax_treatment tax_treatment [not null, default: "taxable"]
  name varchar(256) [not null]
  institution_id uuid [ref: > institutions.id]
  currency char(3) [not null, ref: > currencies.id]
  lifetime_contribution_limit bigint [note: "lifetime cap in account currency base units; null if not applicable (e.g., FHSA=4000000, RESP=5000000)"]
  is_hidden boolean [not null, default: false]
  closed_at timestamptz [note: "null = active; non-null = closed on this date"]
  created_at timestamptz [not null]
}

Table account_balance_snapshots [headercolor: #10B981] {
  account_id uuid pk [ref: > accounts.id]
  balance bigint [not null, note: "stored in the base unit of the currency (e.g., cents for CAD/USD, 1 JPY, etc.)"]
  ts timestamptz pk [not null]
}

Table tax_advantaged_configs [headercolor: #10B981, note: "per-account, per-year limits for tax-advantaged accounts; user is responsible for entering limits"] {
  account_id uuid pk [not null, ref: > accounts.id]
  year smallint pk [not null]
  contribution_limit bigint [not null, note: "annual contribution limit in account currency base units"]
  withdrawal_limit bigint [note: "annual withdrawal limit; null means no limit"]
}

enum category_kind {
  expense
  income
  transfer
}

Table categories [headercolor: #F59E0B, note: "app seeds a default 'Uncategorized' category per kind per user so category_id on transactions is never null"] {
  id uuid pk
  household_id uuid [ref: > households.id]
  owner_id uuid [not null, ref: > users.id]
  name text [not null]
  kind category_kind [not null]
  parent_id uuid [ref: > categories.id]
  created_at timestamptz [not null]

  indexes {
    (owner_id, name, kind) [unique, name: "uq_category_owner_name_kind"]
  }
}

Table merchants [headercolor: #F59E0B, note: "per-user merchant registry; includes employers, people, stores — anything that sends or receives money"] {
  id uuid pk
  owner_id uuid [not null, ref: > users.id]
  name varchar(256) [not null]
  default_category_id uuid [ref: > categories.id, note: "auto-categorization hint for new transactions with this merchant"]
  created_at timestamptz [not null]
}

Table transactions [headercolor: #F59E0B, note: "acts as a ledger: positive amount = money in, negative = money out; transfers are two independent rows"] {
  id uuid pk
  created_by_user_id uuid [not null, ref: > users.id]
  account_id uuid [not null, ref: > accounts.id]
  ts timestamptz [not null]
  merchant_id uuid [ref: > merchants.id, note: "null for transfers between own accounts"]
  category_id uuid [not null, ref: > categories.id]
  amount bigint [not null, note: "stored in base currency units; positive = inflow, negative = outflow"]
  currency char(3) [not null, ref: > currencies.id, note: "defaults to the user's account currency"]
  fx_rate numeric [default: null, note: "used to be autoderived from the transaction; should show 1.0 in the frontend as default value"]
  notes text [note: "user-provided notes for context or analysis"]
  created_at timestamptz [not null, note: "when the transaction was entered into the system"]
  updated_at timestamptz [not null, note: "tracks last modification; useful for sync and conflict resolution"]
}

Table tags [headercolor: #F59E0B, note: "per-user tag registry for cross-cutting transaction analysis beyond categories"] {
  id uuid pk
  owner_id uuid [not null, ref: > users.id]
  name varchar(64) [not null]
  created_at timestamptz [not null]
  // unique constraint: (owner_id, name)
}

Table transaction_tags [headercolor: #F59E0B, note: "junction table instead of a tags column on transactions — enables indexed joins for tag queries, single-row renames, and consistent tag naming across transactions"] {
  transaction_id uuid pk [ref: > transactions.id]
  tag_id uuid pk [ref: > tags.id]
}

enum recurrence_freq {
  daily
  weekly
  monthly
  yearly
}

Table budgets [headercolor: #F43F5E, note: "check constraint: exactly one of owner_id or household_id must be non-null"] {
  id uuid pk
  owner_id uuid [ref: > users.id]
  household_id uuid [ref: > households.id]
  parent_budget_id uuid [ref: > budgets.id, note: "null = template/one-off; non-null = auto-generated instance pointing to its template"]
  name varchar(256) [not null]
  period_start date [not null]
  period_end date [not null]
  recurrence_freq recurrence_freq [note: "null = one-off budget; only set on the template"]
  recurrence_interval smallint [note: "e.g., 1 = every period, 2 = every other, 11 = every 11th; null when recurrence_freq is null"]
  overall_limit bigint [default: null, note: "optional spending cap across all categories; stored in the budget's currency units"]
  currency char(3) [not null, ref: > currencies.id]
  created_at timestamptz [not null]
}

Table budget_allocations [headercolor: #F43F5E, note: "a named spending limit within a budget; covers both single-category and grouped-category limits"] {
  id uuid pk
  budget_id uuid [not null, ref: > budgets.id]
  name varchar(256) [not null, note: "e.g., 'Groceries' for a single category or 'All Food' for a group"]
  amount bigint [not null, note: "spend limit in the budget's currency units"]
}

Table budget_allocation_categories [headercolor: #F43F5E] {
  allocation_id uuid pk [ref: > budget_allocations.id]
  category_id uuid pk [ref: > categories.id]
}

// Scopes a household budget to specific members; when no rows exist for a budget, all household members are included
Table budget_members [headercolor: #F43F5E] {
  budget_id uuid pk [ref: > budgets.id]
  user_id uuid pk [ref: > users.id]
}
