# Dev tooling configuration
# Copy to dev/.env and fill in real values

# Local development Postgres container managed by the dev-db scripts
DEV_PG_CONTAINER=lumina-finance-dev-db

# Remote production source for database dumps
REMOTE_SSH_HOST=
REMOTE_DB_CONTAINER=

# --- Remote dev server ---
# reset-dev-server builds the image on this host over a Docker context and runs it
# through the host's own static compose file over SSH

# Local Docker context whose endpoint is ssh://DEV_VM_SSH_HOST
DEV_VM_DOCKER_CONTEXT=dev

# SSH host alias for the dev server, from the local SSH config
DEV_VM_SSH_HOST=

# Directory on the dev server holding its static compose file and env file
DEV_VM_DEPLOY_DIR=

# Image tag built on the dev server and referenced by its compose file
DEV_VM_IMAGE=luminahq/lumina-finance:dev
