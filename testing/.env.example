# Testing tooling configuration
# Copy to testing/.env and fill in real values

# Local development Postgres container managed by the dev-db scripts
DEV_PG_CONTAINER=lumina-finance-dev-db

# Remote staging source for database dumps
REMOTE_SSH_HOST=
REMOTE_DB_CONTAINER=

# --- Docker test-stack environment ---
# Passed to docker compose for the local test stack, kept separate from the
# tooling vars above

DB_HOST=postgres
DB_PORT=5432
DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=change-me
APP_URL=http://localhost:8080
UPDATE_CHECKS_ENABLED=true
FRANKFURTER_URL=https://api.frankfurter.dev/v2

# Image tag the stack runs, build tags the local image with this
APP_IMAGE_TAG=test
APP_VERSION=0.0.0