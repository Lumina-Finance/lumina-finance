# Backend test environment example
# Copy to backend/.env to run the backend against the local test database
# Override individual values as needed

RUNTIME=server
TESTING=1

APP_URL=http://localhost:5173

# Isolated test database, safe to drop and recreate
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lumina_test
DB_USER=lumina_test
DB_PASSWORD=lumina_test

# JWT signing
# Key paths are not set here, they come from tests/.env.test.local locally and
# from the environment in CI, since an absolute path cannot be committed
JWT_ACCESS_KID=access-v1-test
JWT_REFRESH_KID=refresh-v1-test
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=86400
JWT_ISSUER=lumina-finance

# Update checks stay off so tests never reach the network
APP_VERSION=0.0.0
UPDATE_CHECKS_ENABLED=false

FRANKFURTER_URL=https://api.frankfurter.dev/v2

# ValKey the cache tests run against. Only those tests read it: the app's own VALKEY_URL stays unset
# here, so every other test runs without a cache
TEST_VALKEY_URL=valkey://127.0.0.1:6379

# Fixed Fernet key so encrypted secrets round-trip in tests
APP_ENCRYPTION_KEY=dES_h7-X0hfDO5OufIrWdgf_NLlUCgeV5psUEijMo48=

# Fixed key for the bank transaction hashes OFX imports keep, so tests can compute them
BANK_TRANSACTION_HASH_KEY=af1fd8a30fbf4a68020cefab44a07988beec58945816cfd92af43accba9d11b7
